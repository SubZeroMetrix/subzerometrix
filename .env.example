# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Local dev unlock (bypasses Stripe payment check) ─────────────────────────
# Set to true in .env.local only. Never true in production.
DEV_UNLOCK=false

# ── App URL ───────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: your Vercel domain or custom domain
NEXT_PUBLIC_APP_URL=https://subzerometrix.com

# ── Resend (email automation) ─────────────────────────────────────────────────
# Get at: https://resend.com — free tier: 3,000 emails/mo
# Optional — app runs without it; email triggers will be skipped gracefully
RESEND_API_KEY=re_...

# ── Affiliate postback shared secrets ─────────────────────────────────────────
# Optional — required only when a partner's postback sends an HMAC signature.
# Get from each affiliate partner's dashboard after onboarding.
# Format: POSTBACK_SECRET_{VENDOR_SLUG_UPPERCASE_UNDERSCORES}
POSTBACK_SECRET_SIMPLY_BUSINESS=
POSTBACK_SECRET_NEXT_INSURANCE=
POSTBACK_SECRET_RELAY=
POSTBACK_SECRET_JOBBER=
POSTBACK_SECRET_HOUSECALL_PRO=
POSTBACK_SECRET_QUICKBOOKS=
POSTBACK_SECRET_ZENBUSINESS=
POSTBACK_SECRET_NAV=
POSTBACK_SECRET_ANGI=

# ── Optional / Future integrations ────────────────────────────────────────────
# These are not used in the current codebase — add when ready.
# Anthropic (AI features — not yet wired):
# ANTHROPIC_API_KEY=sk-ant-...
# PostHog (product analytics — not yet wired):
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# n8n automation webhook secret (not yet wired):
# N8N_WEBHOOK_SECRET=your-secret-here
