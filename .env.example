# SubZero Metrix — Environment Variables (PLACEHOLDERS ONLY — never commit real values)
# Copy to .env.local for development. Set in Vercel dashboard for Preview/Production.

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (affiliate site: products, leads, contact, admin CMS) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (Metrix Command Center landing-page leads only — dedicated
#    isolated project "SubZeroMetrixLandingPage", used only by
#    src/app/api/mcc-lead/route.ts, never shared with the above) ──
MCC_LEADS_SUPABASE_URL=
MCC_LEADS_SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (future SubZero Metrix products — NOT for affiliate commissions) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email Provider ───────────────────────────────────────────
EMAIL_PROVIDER=
EMAIL_PROVIDER_API_KEY=
EMAIL_LIST_ID=

# ── Analytics ────────────────────────────────────────────────
ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=

# ── Security ─────────────────────────────────────────────────
AFFILIATE_CLICK_SIGNING_SECRET=

# ── Contact ──────────────────────────────────────────────────
CONTACT_EMAIL=
ADMIN_EMAIL_ALLOWLIST=
